# Cases for the app-test output gate. One per line:
#
#   <expected> <TAB> <command> [<TAB> <expected rewrite>]
#
# <expected> is `pass` (no opinion — falls through to the normal permission
# flow), `allow` (rewritten; the third field is the exact command that must come
# out), or `deny`.
#
# `AT` stands in for the recipe name everywhere below, and the runner expands it
# to `app-test`. Writing it literally would make this file's own contents match
# the gate and get the runner denied — which is itself one of the false
# positives being fixed here, and worth not re-creating.

# --- left alone ------------------------------------------------------------
pass	just AT
pass	just AT tests/app-test/at0385-masthead.test.ts
pass	just AT-changed
pass	just AT-all
pass	TUG_APPTEST_JSON=/tmp/r.json just AT x.test.ts
pass	just AT x.test.ts | tee /tmp/out.txt
pass	just AT x.test.ts > /tmp/out.txt
pass	just AT-select | tail -20
pass	just AT-covers-check | grep missing
# The pipe belongs to the build, not to the test run. This is the shape that
# was being denied wrongly, dozens of times a day.
pass	cd tugdeck && bunx vite build 2>&1 | tail -3 && cd .. && just AT tests/app-test/at0385.test.ts
pass	cd tugdeck && bunx vite build | tail -3 && cd .. && just AT x.test.ts && echo done
# A mention inside an argument is not an invocation.
pass	echo "just AT x.test.ts | tail -20" | cat
pass	rg 'just AT' justfile | head -5

# --- rewritten -------------------------------------------------------------
allow	just AT x.test.ts | tail -30	just AT x.test.ts
allow	just AT x.test.ts 2>&1 | tail -30	just AT x.test.ts 2>&1
allow	just AT-changed | grep VERDICT	just AT-changed
allow	just AT x.test.ts | grep -A 8 Failures: | head -20	just AT x.test.ts
allow	TUG_APPTEST_JSON=/tmp/r.json just AT x.test.ts | tail -5	TUG_APPTEST_JSON=/tmp/r.json just AT x.test.ts
# The filter comes off; the rest of the chain survives untouched.
allow	cd tugdeck && bunx vite build | tail -3 && cd .. && just AT x.test.ts | tail -20	cd tugdeck && bunx vite build | tail -3 && cd .. && just AT x.test.ts
allow	just AT x.test.ts | tail -20 && echo done	just AT x.test.ts && echo done
allow	just AT a.test.ts | tail -5 ; just AT b.test.ts | tail -5	just AT a.test.ts ; just AT b.test.ts

# --- denied ----------------------------------------------------------------
deny	just AT x.test.ts | grep VERDICT > /tmp/out.txt
deny	(just AT x.test.ts | tail -20)
deny	V=$(just AT x.test.ts | tail -1) && echo $V
